# ─── Foundry build artifacts ─────────────────────────────────────────────────
/out/
/cache/
/frontend

# ─── Environment & secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Foundry broadcast logs (contain tx hashes / deployer details) ────────────
/broadcast/*/31337/
/broadcast/**/dry-run/
/broadcast/*

# ─── Dependencies (managed by forge install / git submodules) ─────────────────
# lib/ is tracked via .gitmodules — do not ignore it entirely.
# Ignore any accidental npm installs inside lib packages.
lib/**/node_modules/
lib/

# ─── Coverage & gas reports ───────────────────────────────────────────────────
lcov.info
/coverage/
gasreport.txt
*.gas-snapshot

# ─── IDE / editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Node (if any tooling uses npm/yarn) ─────────────────────────────────────
node_modules/
package-lock.json
yarn.lock

# ─── Claude Code internal state ───────────────────────────────────────────────
.claude/
CLAUDE.md